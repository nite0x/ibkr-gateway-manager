IBKR_GATEWAY_MANAGER_USERNAME=admin
IBKR_GATEWAY_MANAGER_PASSWORD=replace-with-your-password
IBKR_GATEWAY_MANAGER_PORT=8088
# Base domain only, e.g. ibkr.example.com (no https://, port, or manager. prefix).
# Leave empty on a fresh install to use only the local HTTP management page.
IBKR_GATEWAY_PUBLIC_DOMAIN=
